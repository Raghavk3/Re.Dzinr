---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { author } = Astro.props;
---

<section class="author-section">
	<div class="noise" aria-hidden="true"></div>
	<div class="blob blob-1" aria-hidden="true"></div>
	<div class="blob blob-2" aria-hidden="true"></div>

	<div class="container">

		<!-- Back link -->
		<a href={translatePath("/blog")} class="back-link">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M19 12H5M12 19l-7-7 7-7"/>
			</svg>
			{t("about.back")}
		</a>

		<!-- Profile layout -->
		<div class="profile">

			<!-- Left: photo + socials -->
			<div class="profile-left">
				{author.data.image ? (
					<div class="photo-wrap">
						<img
							src={author.data.image}
							alt={author.data.name}
							class="photo"
						/>
						<div class="photo-overlay" />
					</div>
				) : (
					<div class="photo-fallback">
						{author.data.name.charAt(0)}
					</div>
				)}

				{author.data.socials && (
					<div class="socials">
						{author.data.socials.linkedin && (
							<a href={author.data.socials.linkedin} target="_blank" rel="noopener noreferrer" class="social-link">
								<!-- LinkedIn SVG -->
								<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
									<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
								</svg>
								LinkedIn
							</a>
						)}
						{author.data.socials.instagram && (
							<a href={author.data.socials.instagram} target="_blank" rel="noopener noreferrer" class="social-link">
								<!-- Instagram SVG -->
								<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
									<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
								</svg>
								Instagram
							</a>
						)}
						{author.data.socials.twitter && (
							<a href={author.data.socials.twitter} target="_blank" rel="noopener noreferrer" class="social-link">
								<!-- X/Twitter SVG -->
								<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
									<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.258 5.63 5.906-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
								</svg>
								Twitter
							</a>
						)}
					</div>
				)}
			</div>

			<!-- Right: text -->
			<div class="profile-right">
				<div class="name-block">
					<p class="role">{author.data.role ?? t("about.teamMember")}</p>
					<h1 class="name">{author.data.name}</h1>
				</div>

				<hr class="divider" />

				{author.data.bio && (
					<p class="bio">{author.data.bio}</p>
				)}

				<div class="prose-slot">
					<slot />
				</div>

				{author.data.skills && author.data.skills.length > 0 && (
					<div class="skills-block">
						<p class="skills-label">{t("about.expertise")}</p>
						<div class="skills-list">
							{author.data.skills.map((skill: string) => (
								<span class="skill-tag">{skill}</span>
							))}
						</div>
					</div>
				)}
			</div>
		</div>
	</div>
</section>

<style>
	.author-section {
		position: relative;
		background: #ffffff;
		min-height: 100vh;
		overflow: hidden;
		padding-bottom: 8rem;
	}

	.noise {
		position: absolute;
		inset: 0;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
		opacity: 0.025;
		pointer-events: none;
		z-index: 0;
	}

	.blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(120px);
		pointer-events: none;
		z-index: 0;
	}
	.blob-1 {
		width: 600px; height: 600px;
		background: radial-gradient(circle, rgba(49,133,255,0.08) 0%, transparent 70%);
		top: -200px; right: -100px;
	}
	.blob-2 {
		width: 500px; height: 500px;
		background: radial-gradient(circle, rgba(252,111,20,0.06) 0%, transparent 70%);
		bottom: 0; left: -150px;
	}

	.container {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin: 0 auto;
		padding: 6rem 2rem 0;
	}

	/* Back link */
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: 'Courier New', monospace;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: #aaaaaa;
		text-decoration: none;
		margin-bottom: 4rem;
		transition: color 0.2s ease;
	}
	.back-link:hover { color: #3185ff; }

	/* Profile grid */
	.profile {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 4rem;
	}

	/* Left column */
	.profile-left {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.photo-wrap {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
		aspect-ratio: 3/4;
	}
	.photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		display: block;
	}
	.photo-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.25) 0%, transparent 60%);
	}
	.photo-fallback {
		aspect-ratio: 3/4;
		border-radius: 16px;
		background: #f0f0f0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 6rem;
		font-weight: 700;
		color: #cccccc;
		font-family: Georgia, serif;
	}

	/* Socials */
	.socials {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6rem 1rem;
		border-radius: 8px;
		border: 1px solid #e8e8e8;
		font-family: 'Courier New', monospace;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #888888;
		text-decoration: none;
		transition: border-color 0.2s ease, color 0.2s ease;
	}
	.social-link:hover {
		border-color: #3185ff;
		color: #3185ff;
	}

	/* Right column */
	.profile-right {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-top: 0.5rem;
	}

	.role {
		font-family: 'Courier New', monospace;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: #fc6f14;
		margin: 0 0 0.75rem;
	}

	.name {
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 800;
		color: #0a0a0a;
		letter-spacing: -0.03em;
		font-family: Georgia, 'Times New Roman', serif;
		line-height: 1.05;
		margin: 0;
	}

	.divider {
		border: none;
		border-top: 1px solid #e8e8e8;
		margin: 0;
	}

	.bio {
		font-size: 1.05rem;
		line-height: 1.85;
		color: #444444;
		margin: 0;
	}

	.prose-slot {
		font-size: 1rem;
		line-height: 1.8;
		color: #666666;
	}
	.prose-slot :global(h2) {
		font-family: Georgia, serif;
		font-size: 1.5rem;
		color: #0a0a0a;
		margin: 2rem 0 0.75rem;
		font-weight: 700;
	}
	.prose-slot :global(p) { margin: 0 0 1rem; }
	.prose-slot :global(strong) { color: #0a0a0a; }
	.prose-slot :global(em) { color: #3185ff; font-style: italic; }

	/* Skills */
	.skills-label {
		font-family: 'Courier New', monospace;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: #aaaaaa;
		margin: 0 0 0.75rem;
	}
	.skills-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.skill-tag {
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid #e8e8e8;
		font-family: 'Courier New', monospace;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #666666;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.profile {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.photo-wrap {
			max-width: 320px;
		}
		.container {
			padding: 4rem 1.25rem 0;
		}
	}
</style>