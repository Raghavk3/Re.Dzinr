---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Authors from "@components/blog/Authors.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "About Us | Re.Dzinr",
	description:
		"Meet the founders of Re.Dzinr — built by two B.Tech students from CMR Institute of Technology, Hyderabad, driven by design, code, and a shared vision.",
	canonical: "https://redzinr.in/blog/",
	openGraph: {
		url: "https://redzinr.in/blog",
		title: "About Us | Re.Dzinr",
		description:
			"Meet Jatin and Raghava — the duo behind Re.Dzinr. Design meets development.",
		images: [
			{
				url: "https://redzinr.in/opengraph/social-og.jpg",
				width: 1200,
				height: 630,
				alt: "Re.Dzinr About Us",
				type: "image/jpeg",
			},
		],
		site_name: "Re.Dzinr",
	},
	twitter: {
		handle: "@redzinr",
		site: "@redzinr",
		cardType: "summary_large_image",
	},
};
---

<BaseLayout seo={seo}>
	<Authors />
</BaseLayout>